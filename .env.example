# Copy to .env and adjust. All variables are optional; sensible defaults are
# applied in config/settings.py. The project runs fully offline with the
# default heuristic provider — no keys required.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- LLM provider ---------------------------------------------------------
# One of: heuristic | anthropic | openai | ollama
SCRAPER_LLM_PROVIDER=heuristic

# Anthropic / Claude (primary real provider).
# NOTE: this is the Anthropic API (console.anthropic.com, billed separately),
#       NOT a claude.ai Pro/Team/Enterprise chat subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (optional; also `pip install openai`).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama / local LLaMA (optional; run `ollama serve` + `ollama pull llama3.1`).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Pipeline thresholds (proposal Table 5.1) -----------------------------
SCRAPER_HEALTH_THRESHOLD=0.80
SCRAPER_MAX_HEAL_ATTEMPTS=3
SCRAPER_FAILURE_MEMORY_SIZE=10
SCRAPER_FETCH_TIMEOUT=20
