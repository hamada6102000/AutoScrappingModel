# Copy to .env and adjust. All variables are optional; sensible defaults are
# applied in config/settings.py. The project runs fully offline with the
# default heuristic provider — no keys required.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- LLM provider ---------------------------------------------------------
# One of: heuristic | groq | anthropic | openai | ollama
# Default is "heuristic" (offline, no key). To use the free Groq LLM, set this
# to "groq" and fill in GROQ_API_KEY below.
SCRAPER_LLM_PROVIDER=groq

# Groq — FREE, fast LLaMA inference (recommended free option).
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative (faster / lighter on rate limits): llama-3.1-8b-instant
GROQ_HOST=https://api.groq.com/openai/v1

# Anthropic / Claude (paid API — separate from a claude.ai subscription).
# NOTE: this is the Anthropic API (console.anthropic.com, billed separately),
#       NOT a claude.ai Pro/Team/Enterprise chat subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (optional; also `pip install openai`).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama / local LLaMA (optional; run `ollama serve` + `ollama pull llama3.1`).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Pipeline thresholds (proposal Table 5.1) -----------------------------
# (The evaluation takes these from eval/sites.yaml instead.)
SCRAPER_HEALTH_THRESHOLD=0.80
SCRAPER_MAX_HEAL_ATTEMPTS=3
SCRAPER_FAILURE_MEMORY_SIZE=10
SCRAPER_FETCH_TIMEOUT=20

# --- Data, LLM limits and accounting ---------------------------------------
# Snapshots, ground-truth sheets and results are written here.
SCRAPER_DATA_DIR=eval_data
# Save the raw HTML of every ordinary (dashboard / run_scrape) live run.
SCRAPER_SAVE_SNAPSHOTS=true
# Ordinary runs may fall back to the heuristic if the LLM fails (always
# flagged). The evaluation forces this off.
SCRAPER_ALLOW_FALLBACK=true
# Expose <title>, <meta> tags, the canonical link and JSON-LD to XPath as a
# <section id="page-metadata"> in the cleaned page (Layer 1).
SCRAPER_STRUCTURED_DATA=true
# Max characters of cleaned HTML sent to the LLM; longer inputs are truncated
# and flagged in the logs.
SCRAPER_LLM_MAX_INPUT_CHARS=60000
# Rate limits (HTTP 429): retries and total waiting before pausing the run.
SCRAPER_LLM_MAX_RETRIES=6
SCRAPER_LLM_MAX_WAIT_SECONDS=900
# Optional USD prices per 1M tokens for cost estimates (leave {} if unknown).
SCRAPER_PRICING={}
# Tokenizer for page token counts (tiktoken encoding name).
SCRAPER_TOKENIZER=cl100k_base
# Optional: open a different database file (e.g. from an exported bundle).
# DJANGO_DB_PATH=
